# DevCard V2 - Environment Variables Template
# Copy this file to .env.local and fill in your actual values

# =============================================================================
# APP CONFIGURATION
# =============================================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SIGNIN_ENABLED=true
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-here-generate-with-openssl-rand-base64-32

# =============================================================================
# DATABASE (PostgreSQL via Neon)
# =============================================================================
DATABASE_URL=postgresql://user:password@localhost:5432/devcard
# Alternative: Neon connection string
# DATABASE_URL=postgresql://user:password@ep-xyz.us-east-2.aws.neon.tech/devcard?sslmode=require

# =============================================================================
# GITHUB OAUTH (Required for DevCard V2)
# =============================================================================
# Create a GitHub OAuth App at: https://github.com/settings/developers
# Authorization callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_ID=your-github-oauth-app-client-id
GITHUB_SECRET=your-github-oauth-app-client-secret

# =============================================================================
# GOOGLE OAUTH (Optional - existing provider)
# =============================================================================
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# =============================================================================
# VERCEL KV (Redis) - For Caching
# =============================================================================
# Used for GitHub data caching and QR code caching
KV_URL=redis://localhost:6379
KV_REST_API_URL=https://your-kv-instance.upstash.io
KV_REST_API_TOKEN=your-kv-api-token
KV_REST_API_READ_ONLY_TOKEN=your-kv-readonly-token

# =============================================================================
# UPSTASH RATE LIMITING
# =============================================================================
# Used for connection request rate limiting (20 requests/hour)
UPSTASH_REDIS_REST_URL=https://your-redis-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-redis-token

# =============================================================================
# AWS S3 (File Storage)
# =============================================================================
# Used for storing wallet pass assets and custom domain certificates
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET=devcard-assets

# =============================================================================
# AWS SES (Email Service)
# =============================================================================
# Used for connection request notifications and system emails
AWS_SES_REGION=us-east-1
AWS_SES_FROM_EMAIL=noreply@yourdomain.com
AWS_SES_FROM_NAME=DevCard

# =============================================================================
# INNGEST (Background Jobs)
# =============================================================================
# Used for GitHub sync, analytics aggregation, and cleanup jobs
INNGEST_EVENT_KEY=your-inngest-event-key
INNGEST_SIGNING_KEY=your-inngest-signing-key
INNGEST_URL=https://api.inngest.com

# =============================================================================
# STRIPE (Payment Processing)
# =============================================================================
# Used for premium subscriptions
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# Stripe Price IDs for DevCard Premium
STRIPE_PREMIUM_MONTHLY_PRICE_ID=price_xxx
STRIPE_PREMIUM_YEARLY_PRICE_ID=price_yyy

# =============================================================================
# WALLET PASS CERTIFICATES (Optional - User Story 2)
# =============================================================================
# Apple Wallet Pass certificates
APPLE_WWDR_CERT=base64-encoded-wwdr-certificate
APPLE_SIGNER_CERT=base64-encoded-signer-certificate
APPLE_SIGNER_KEY=base64-encoded-signer-key
APPLE_KEY_PASSPHRASE=your-certificate-passphrase
APPLE_TEAM_IDENTIFIER=your-apple-team-id
APPLE_PASS_TYPE_IDENTIFIER=pass.com.yourdomain.devcard

# Google Wallet credentials
GOOGLE_ISSUER_ID=your-google-issuer-id
GOOGLE_SERVICE_KEY=base64-encoded-service-account-key

# =============================================================================
# ANALYTICS & MONITORING (Optional)
# =============================================================================
# Privacy-compliant analytics hashing salt
ANALYTICS_HASH_SALT=your-random-salt-for-visitor-id-hashing

# Sentry (Error Tracking - Optional)
SENTRY_DSN=https://xxx@sentry.io/xxx
NEXT_PUBLIC_SENTRY_DSN=https://xxx@sentry.io/xxx

# =============================================================================
# DEVELOPMENT TOOLS
# =============================================================================
# Enable development features
NODE_ENV=development

# Drizzle Studio
DRIZZLE_STUDIO_PORT=4983
