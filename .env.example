# StackPass Environment Variables
# Copy this file to .env.local and fill in your actual values

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Database (Supabase PostgreSQL)
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# NextAuth
AUTH_SECRET="[GENERATE_WITH: openssl rand -base64 32]"
NEXTAUTH_URL=http://localhost:3000

# GitHub OAuth
GITHUB_ID="[YOUR_GITHUB_OAUTH_APP_ID]"
GITHUB_SECRET="[YOUR_GITHUB_OAUTH_SECRET]"

# Email (Resend)
RESEND_API_KEY="[YOUR_RESEND_API_KEY]"
RESEND_FROM_EMAIL="noreply@stackpass.dev"

# Supabase
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[YOUR_ANON_KEY]"
SUPABASE_SERVICE_ROLE_KEY="[YOUR_SERVICE_ROLE_KEY]"

# AWS S3 (for file uploads)
AWS_ACCESS_KEY_ID="[YOUR_AWS_ACCESS_KEY]"
AWS_SECRET_ACCESS_KEY="[YOUR_AWS_SECRET]"
AWS_REGION="[YOUR_REGION]"
AWS_BUCKET_NAME="[YOUR_BUCKET]"

# Payment Providers (Stripe for Premium Subscriptions)
STRIPE_SECRET_KEY="[YOUR_STRIPE_SECRET]"
STRIPE_WEBHOOK_SECRET="[YOUR_STRIPE_WEBHOOK_SECRET]"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="[YOUR_STRIPE_PUBLISHABLE]"

# Stripe Price IDs (Get from Stripe Dashboard after creating product)
# Premium: $49/year (annual only - no monthly option)
STRIPE_PREMIUM_ANNUAL_PRICE_ID="[STRIPE_PRICE_ID_FOR_PREMIUM_ANNUAL]"

# Admin Configuration
ADMIN_EMAILS="admin@example.com"

# Cron Job Authentication (Vercel)
CRON_SECRET="[GENERATE_RANDOM_STRING]"

# Redis/KV (Optional - for caching)
KV_REST_API_URL="[YOUR_VERCEL_KV_URL]"
KV_REST_API_TOKEN="[YOUR_VERCEL_KV_TOKEN]"
